// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "buffer_font_family": "JetBrains Mono",
  "enable_language_server": false,
  "disable_ai": true,
  "project_panel": {
    "indent_size": 16.0,
    "git_status": false,
    "default_width": 200.0,
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": "Zed (Default)",
  "base_keymap": "SublimeText",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Fleetish",
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "tab_size": 2,
  "languages": {
    "Rust":        { "tab_size": 2 },
    "JavaScript":  { "tab_size": 2 },
    "TypeScript":  { "tab_size": 2 },
    "TSX":         { "tab_size": 2 },
    "JSON":        { "tab_size": 2 },
    "JSONC":       { "tab_size": 2 },
    "HTML":        { "tab_size": 2 },
    "CSS":         { "tab_size": 2 },
    "SCSS":        { "tab_size": 2 },
    "YAML":        { "tab_size": 2 },
    "Markdown":    { "tab_size": 2 },
    "Shell Script": { "tab_size": 2 },
    "C":           { "tab_size": 2 },
    "C++":         { "tab_size": 2 },
    "Java":        { "tab_size": 2 },
    "Kotlin":      { "tab_size": 2 },
    "PHP":         { "tab_size": 2 },
    "Ruby":        { "tab_size": 2 },
    "Lua":         { "tab_size": 2 },
    "Dart":        { "tab_size": 2 },
    "Elixir":      { "tab_size": 2 }
  }
}
